# ====================================================================
# COGNITO: Cognitive Question Generation & Intelligent Taxonomy Optimizer
# Environment Configuration Template
# ====================================================================

# --------------------------------------------------------------------
# 1. Database Configuration
# --------------------------------------------------------------------
# Default SQLite database (zero-configuration local run):
DATABASE_URL=sqlite:///./cognito.db
# Or production PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/cognito_db

# ChromaDB persistent vector storage directory:
CHROMA_PERSIST_DIR=./chroma_db

# --------------------------------------------------------------------
# 2. LLM Provider Configuration
# --------------------------------------------------------------------
# Provider options:
# - "auto"      : Automatically detects available provider (Cloud API > Ollama > Resilient Engine)
# - "ollama"    : Local models via Ollama (llama3, mistral, llama3.2, etc.)
# - "openai"    : OpenAI or OpenAI-compatible endpoints (Groq, vLLM, DeepSeek, Together)
# - "gemini"    : Google Gemini Generative AI API
# - "anthropic" : Anthropic Claude API
# - "fallback"  : Internal deterministic cognitive classifier
LLM_PROVIDER=auto

# Inference Parameters (Deterministic academic evaluation: 0.1 - 0.2)
LLM_TEMPERATURE=0.15
LLM_TIMEOUT=180.0
LLM_MAX_RETRIES=2

# --------------------------------------------------------------------
# 2a. Local LLM via Ollama Setup
# --------------------------------------------------------------------
# Ensure Ollama is running: `ollama run llama3` or `ollama run mistral`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_KEEP_ALIVE=10m

# --------------------------------------------------------------------
# 2b. Cloud LLM via OpenAI / Compatible Setup
# --------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# Or Groq:
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.1-70b-versatile

# --------------------------------------------------------------------
# 2c. Cloud LLM via Google Gemini Setup
# --------------------------------------------------------------------
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-1.5-flash

# --------------------------------------------------------------------
# 2d. Cloud LLM via Anthropic Setup
# --------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --------------------------------------------------------------------
# 3. Assessment Thresholds
# --------------------------------------------------------------------
REPETITION_THRESHOLD=0.85
PARAPHRASE_THRESHOLD=0.70
CAS_APPROVAL_THRESHOLD=0.82
