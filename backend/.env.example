DATABASE_URL=sqlite:///./cognito.db
CHROMA_PERSIST_DIR=./chroma_db

LLM_PROVIDER=auto
LLM_TEMPERATURE=0.15
LLM_TIMEOUT=180.0
LLM_MAX_RETRIES=2

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:latest
OLLAMA_KEEP_ALIVE=10m

